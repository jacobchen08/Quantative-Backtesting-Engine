# Backend (read by backend/app/config.py). Values shown are the defaults.
# SQLite path is relative to the directory uvicorn runs in (backend/).
DATABASE_URL=sqlite:///./quant.db
# Optional Postgres from docker-compose.yml:
# DATABASE_URL=postgresql+psycopg://quant:quant@localhost:5432/quant
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
# 1 = never download: a ticker missing from the cache returns 503 (the browser tests run this way).
QUANT_OFFLINE=

# Frontend (read by Vite at build/dev time). Empty = same origin; in dev the Vite proxy forwards /api.
VITE_API_URL=
